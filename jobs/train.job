# jobs/train.job
# Submit with: condor_submit jobs/train.job
# Replace YOUR_USERNAME with your actual username.

Universe       = vanilla
Executable     = /nethome/YOUR_USERNAME/projects/nmt-starter/scripts/run.sh
Arguments      = configs/sample.yaml

Log    = /nethome/YOUR_USERNAME/logs/nmt-starter/run.$(ClusterId).$(Year)_$(Month)_$(Day).log
Output = /nethome/YOUR_USERNAME/logs/nmt-starter/run.$(ClusterId).$(Year)_$(Month)_$(Day).out
Error  = /nethome/YOUR_USERNAME/logs/nmt-starter/run.$(ClusterId).$(Year)_$(Month)_$(Day).err

request_cpus   = 4
request_memory = 8GB
request_gpus   = 1
+GPUJob        = true

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

Queue
